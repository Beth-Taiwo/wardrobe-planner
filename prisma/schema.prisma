generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model DressEntry {
  id            String           @id @db.VarChar(36)
  userId        String           @map("user_id") @db.VarChar(36)
  date          String           @db.VarChar(10)
  title         String           @db.VarChar(255)
  color         String?          @db.VarChar(100)
  category      String?          @db.VarChar(100)
  notes         String?          @db.Text
  imageUrl      String?          @map("image_url") @db.Text
  sourceUrl     String?          @map("source_url") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clothingItems DressEntryItem[]

  @@unique([userId, date], map: "uq_dress_entries_user_date")
  @@index([userId, date], map: "idx_dress_entries_user_date")
  @@map("dress_entries")
}

model ClothingItem {
  id           String           @id @db.VarChar(36)
  userId       String           @map("user_id") @db.VarChar(36)
  name         String           @db.VarChar(255)
  label        String           @db.VarChar(100)
  color        String?          @db.VarChar(100)
  imageUrl     String?          @map("image_url") @db.Text
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dressEntries DressEntryItem[]
  outfitPlans  OutfitPlanItem[]

  @@index([userId, label], map: "idx_clothing_items_user_label")
  @@map("clothing_items")
}

model DressEntryItem {
  dressEntryId   String       @map("dress_entry_id") @db.VarChar(36)
  clothingItemId String       @map("clothing_item_id") @db.VarChar(36)
  createdAt      DateTime     @default(now()) @map("created_at")
  dressEntry     DressEntry   @relation(fields: [dressEntryId], references: [id], onDelete: Cascade)
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@id([dressEntryId, clothingItemId])
  @@map("dress_entry_items")
}

model OutfitPlan {
  id          String           @id @db.VarChar(36)
  userId      String           @map("user_id") @db.VarChar(36)
  date        String           @db.VarChar(10)
  eventName   String           @map("event_name") @db.VarChar(255)
  prepNotes   String?          @map("prep_notes") @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitPlanItem[]

  @@index([userId, date], map: "idx_outfit_plans_user_date")
  @@map("outfit_plans")
}

model OutfitPlanItem {
  outfitPlanId  String       @map("outfit_plan_id") @db.VarChar(36)
  clothingItemId String      @map("clothing_item_id") @db.VarChar(36)
  createdAt     DateTime     @default(now()) @map("created_at")
  outfitPlan    OutfitPlan   @relation(fields: [outfitPlanId], references: [id], onDelete: Cascade)
  clothingItem  ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@id([outfitPlanId, clothingItemId])
  @@map("outfit_plan_items")
}

model User {
  id             String           @id @db.VarChar(36)
  email          String           @db.VarChar(255)
  normalizedEmail String          @unique @map("normalized_email") @db.VarChar(255)
  displayName    String?          @map("display_name") @db.VarChar(255)
  passwordHash   String?          @map("password_hash") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  dressEntries   DressEntry[]
  clothingItems  ClothingItem[]
  outfitPlans    OutfitPlan[]
  resetTokens    PasswordResetToken[]

  @@map("users")
}

model Session {
  id          String   @id @db.VarChar(36)
  tokenHash   String   @unique @map("token_hash") @db.VarChar(128)
  userId      String   @map("user_id") @db.VarChar(36)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model OAuthAccount {
  id                String   @id @db.VarChar(36)
  provider          String   @db.VarChar(50)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  userId            String   @map("user_id") @db.VarChar(36)
  providerEmail     String?  @map("provider_email") @db.VarChar(255)
  emailVerified     Boolean  @default(false) @map("email_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "uq_oauth_provider_account")
  @@index([userId], map: "idx_oauth_accounts_user")
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String   @id @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.VarChar(36)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}
