generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model DressEntry {
  id            String           @id @db.VarChar(36)
  date          String           @unique @db.VarChar(10)
  title         String           @db.VarChar(255)
  color         String?          @db.VarChar(100)
  category      String?          @db.VarChar(100)
  notes         String?          @db.Text
  imageUrl      String?          @map("image_url") @db.Text
  sourceUrl     String?          @map("source_url") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  clothingItems DressEntryItem[]

  @@index([date], map: "idx_dress_entries_date")
  @@map("dress_entries")
}

model ClothingItem {
  id           String           @id @db.VarChar(36)
  name         String           @db.VarChar(255)
  label        String           @db.VarChar(100)
  color        String?          @db.VarChar(100)
  imageUrl     String?          @map("image_url") @db.Text
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  dressEntries DressEntryItem[]

  @@index([label], map: "idx_clothing_items_label")
  @@map("clothing_items")
}

model DressEntryItem {
  dressEntryId   String       @map("dress_entry_id") @db.VarChar(36)
  clothingItemId String       @map("clothing_item_id") @db.VarChar(36)
  createdAt      DateTime     @default(now()) @map("created_at")
  dressEntry     DressEntry   @relation(fields: [dressEntryId], references: [id], onDelete: Cascade)
  clothingItem   ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@id([dressEntryId, clothingItemId])
  @@map("dress_entry_items")
}
